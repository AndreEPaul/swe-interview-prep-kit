#!/bin/sh
# Checks the commits a push would publish, before they leave this machine.
# Off until you enable it for this clone: git config core.hooksPath .githooks
# To include your private deny-list, set PEER_KIT_DENY_LIST. See CONTRIBUTING.md, "Checks".

remote=$1

is_zero() {
    case $1 in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

root=$(git rev-parse --show-toplevel) || exit 1
python=$(command -v python3 || command -v python) || {
    echo "pre-push: Python 3 not found, so the commits cannot be checked. Install it, or skip this check once with: git push --no-verify" >&2
    exit 1
}

status=0
while read -r _ local_sha _ remote_sha; do
    is_zero "$local_sha" && continue # deleting a remote branch
    if ! is_zero "$remote_sha" && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        # A new branch, or an update this clone has not fetched: take every commit no remote-tracking branch has.
        new=$(git rev-list --topo-order "$local_sha" --not --remotes="$remote" --) || {
            echo "pre-push: could not list the commits to check" >&2
            exit 1
        }
        [ -n "$new" ] || continue
        oldest=$(printf '%s\n' "$new" | tail -n 1)
        if git rev-parse --verify --quiet "$oldest^" >/dev/null; then
            range="$oldest^..$local_sha"
        else
            range=$local_sha
        fi
    fi
    "$python" "$root/tools/check.py" --history "$range" </dev/null || status=1
done
exit $status
